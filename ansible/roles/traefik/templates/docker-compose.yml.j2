services:
  traefik:
    image: traefik:v3.0
    ports: ["80:80", "443:443", "8080:8080"]
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - ./traefik.yml:/etc/traefik/traefik.yml:ro
      - ./acme.json:/acme.json
    networks: [homelab_proxy]
    mem_limit: 256m
    restart: unless-stopped

networks:
  homelab_proxy:
    external: true
