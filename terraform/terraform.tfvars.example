# --- Proxmox ---
pm_endpoint           = "https://proxmox.example:8006/"
pm_api_token          = "user@pam!example_token"
pm_api_secret         = "<proxmox-secret>"
pm_insecure           = true
target_node           = "pve"

# --- Template & SSH ---
debian_template_id    = 9000
ssh_public_key        = "ssh-ed25519 AAAA... votre clé publique ... user@host"

# --- Réseau ---
gateway               = "192.168.1.1"

# --- VMs ---
vms = {
  network = {
    vm_id       = 101
    name        = "srv-network"
    description = "Traefik, Pihole, Unbound"
    ip_address  = "192.168.1.11/24"
    memory      = 1024
    disk_size   = 10
  }
  media = {
    vm_id       = 102
    name        = "srv-media"
    description = "Immich, Jellyfin, Navidrome, Gokapi"
    ip_address  = "192.168.1.12/24"
    memory      = 1024
    # disk_size = 20 (utilise la valeur par défaut définie dans variables.tf)
  }
  apps = {
    vm_id       = 103
    name        = "srv-apps"
    description = "Gitea, CI/CD, Searxng, Radicale, Joplin, Shlink, Speedtest, Uptime-Kuma, Crafty"
    ip_address  = "192.168.1.13/24"
    # memory et disk_size utilisent les valeurs par défaut
    tags        = ["homelab", "apps"]
  }
}
